# ─── Secrets & credentials (NEVER commit) ───────────────────────────
.env
*.env
!.env.example
config.ini
OxyPC_passwords.docx
UAT_Credentials_Sheet.txt
setup_uat_input.txt
*.pem
*.key

# ─── WhatsApp service: live auth session + cache (account-takeover risk) ──
wa-service/.wwebjs_auth/
wa-service/.wwebjs_cache/

# ─── Dependencies (install, don't commit) ───────────────────────────
node_modules/
.venv/
venv/
env/
*.egg-info/

# ─── Python build / cache artifacts ─────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
build/
dist/

# ─── Runtime user uploads (CRM lists, IQC photos, KYC docs — PII) ───
uploads/*
!uploads/.gitkeep

# ─── Trade Partner payment proofs (financial docs — never public, never in git) ───
private_uploads/

# ─── Generated stress-test reports (runtime output, not source) ─────
# Written by the stress-test module at run time. Without this they show as
# untracked on every server, and `git clean -fd` on a deploy box would delete
# them alongside anything else unignored sitting in the tree.
static/stress_reports/*
!static/stress_reports/.gitkeep

# ─── Database backups & dumps ───────────────────────────────────────
backups/
*.dump
*.sqlite
*.sqlite3

# ─── Logs ───────────────────────────────────────────────────────────
*.log
logs/

# ─── OS / editor cruft ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp

# ─── Throwaway verification harnesses (not part of the app) ─────────
/verify_*.py
/_scan_*.py
/_repro_*.py
/_wrap_sidebar_labels.py
/verify_sprint.py
/_check2.py
/_content_check.py
/_grncheck.py
/_navcheck.py
/_perm2.py
/_permcheck.py
/_test_perm_enforce.py
*.bak
/seed_qa_chat.py
/seed_qa_30days.py

# Agent installer bundle — ignore the folder but TRACK the agent exe so the
# IQC "Download & run the OxyQC Agent" link works on GitHub builds / deploys.
downloads/*
!downloads/Diagnose_Device_Agent.exe
.gstack/

# ── Throwaway diagnostic / verification scratch (repo root only) ─────────────
# One-off scripts written while debugging: DB probes, end-to-end checks, extracted
# inline JS for syntax checking, prod read-only inspectors. They are deliberately
# kept on disk rather than deleted, but they are not part of the app.
#
# Every pattern is anchored with a leading "/" so it matches the repo ROOT only.
# An unanchored "_*.py" would also match models/__init__.py and every other
# package marker, silently un-tracking a new package and breaking the import.
# Subdirectory partials like templates/crm/_assign_leads_rows.html are likewise
# untouched. Already-tracked files are unaffected by gitignore either way.
/_chk_*.py
/_e2e_*.py
/_fix_*.py
/_prod_*.py
/_qa_*.py
/_repro_*.py
/_smoke_tmp*.py
/_verify_*.py
/_test_bucket*.py
/_test_call*.py
/_js*.js
/_ready_rendered.html
/_server.log
/check_admin_tmp.py
/err.txt

# Local visual-QA helper (stubs the partner session) — never deployed
qa_partner_server.py
pe_harness.html
static/pe_harness.html
_probe_*.py
_probe_*.js

# One-off read-only diagnostic scripts copied onto the servers. The internal
# server's autodeploy refuses to run while its working tree is dirty, so these
# are ignored rather than left untracked where they would block every deploy.
_db_fingerprint.py
_id_dump.py
_export_internal_only.py
_check_masterdata_widths.py
_sync_part_names.py
ids_supabase.json
_list_part_makes.py
_list_make_gaps.py
_fix_blank_make.py
_fix_make_case.py
_map_audit.py
_dt_probe.py
_part_diff.py
_consumed_probe.py
