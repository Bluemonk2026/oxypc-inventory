# systemd unit — copy to /etc/systemd/system/oxypc.service
# Auto-starts OxyPC Inventory, restarts on crash, runs as www-data.
#
#   sudo cp deploy/oxypc.service /etc/systemd/system/oxypc.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now oxypc
#   sudo systemctl status oxypc
#
# --workers 4 assumes app.on_event("startup")'s periodic cache refresh
# (main.py) is in place — it bounds cross-worker cache staleness (role
# permissions, stage-transition rules, etc.) to ~60s, which is what makes
# running more than one worker safe. Tune worker count to your box's actual
# CPU core count (~2×cores+1 is the usual rule of thumb for an I/O-bound
# async app) and check database.py's OXYPC_DB_POOL_SIZE/OXYPC_DB_MAX_OVERFLOW
# env vars stay under your Postgres max_connections when you change this.

[Unit]
Description=OxyPC Inventory (FastAPI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/oxypc
EnvironmentFile=/opt/oxypc/.env
ExecStart=/opt/oxypc/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5
# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
