# --workers 4 assumes app.on_event("startup")'s periodic cache refresh
# (main.py) is in place — it bounds cross-worker cache staleness (role
# permissions, stage-transition rules, etc.) to ~60s, which is what makes
# running more than one worker safe. Tune worker count to your box's actual
# CPU core count (~2×cores+1 is the usual rule of thumb for an I/O-bound
# async app) and check database.py's OXYPC_DB_POOL_SIZE/OXYPC_DB_MAX_OVERFLOW
# env vars stay under your Postgres max_connections when you change this.

[Unit]
Description=OxyPC Inventory Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=oxypc
Group=oxypc
WorkingDirectory=/opt/oxypc-inventory
EnvironmentFile=/opt/oxypc-inventory/.env
ExecStart=/opt/oxypc-inventory/venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 4 \
    --log-level info
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oxypc-inventory
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
